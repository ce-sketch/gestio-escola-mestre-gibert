rules_version = '2';

// Regles de seguretat de Firestore per al projecte "Escola Mestre Gibert".
//
// Com aplicar-les:
// 1. A Firebase Console, ves a Firestore Database → pestanya "Reglas"
// 2. Enganxa el contingut d'aquest fitxer, substituint el que hi hagi
// 3. Clica "Publicar"
//
// Criteri general: qualsevol usuari autenticat i de personal del centre
// (domini @escolamestregibert.cat, i que NO sigui un compte d'alumnat —
// aquests comencen sempre per "00") pot llegir i introduir dades
// pedagògiques (assistència, avaluació, documentació). La gestió
// d'alumnes, el calendari escolar i el backup, en canvi, només els pot
// escriure el compte administrador (ce@escolamestregibert.cat) — la resta
// de personal els pot seguir consultant, però no modificar-los.

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null && request.auth.token.email == 'ce@escolamestregibert.cat';
    }

    // Personal del centre: domini correcte i NO és un compte d'alumnat
    // (que sempre comencen per "00", doble zero). Aquesta comprovació es
    // fa aquí, a Firestore, perquè cap alumne pugui llegir ni escriure
    // res encara que es saltés la pantalla de login de l'app.
    function esComptePersonal() {
      return request.auth != null
        && request.auth.token.email.matches('.*@escolamestregibert[.]cat$')
        && !request.auth.token.email.matches('^00.*');
    }

    // ── Curs escolar en marxa, calculat aquí mateix ──────────────────────
    // Es fa servir per deixar netejar dades de proves del curs actual sense
    // obrir la porta a esborrar l'històric d'anys anteriors. El tall és
    // l'agost, igual que a cursEscolarActual() de l'app.
    function anyIniciCurs() {
      return request.time.month() >= 8 ? request.time.year() : request.time.year() - 1;
    }

    // "2026-27"
    function cursEnMarxa() {
      return string(anyIniciCurs()) + '-' + string(anyIniciCurs() + 1)[2:4];
    }

    // Assistència: registres d'entrada per data, mai se sobreescriuen.
    // L'administrador en pot esborrar, però NOMÉS els del curs en marxa
    // (l'assistència no porta el camp "cursEscolar", així que es mira la
    // data: de l'1 de setembre al 31 d'agost, com fa la consulta de l'app).
    // L'històric de cursos tancats queda intocable per a tothom.
    match /assistencia/{registreId} {
      allow read: if esComptePersonal();
      allow create: if esComptePersonal();
      allow update: if false; // un registre existent no es modifica mai
      allow delete: if esAdmin()
        && resource.data.data >= string(anyIniciCurs()) + '-09-01'
        && resource.data.data <= string(anyIniciCurs() + 1) + '-08-31';
    }

    // Avaluació: notes per alumne, àrea i trimestre. Mateix criteri, però
    // aquí sí que hi ha el camp "cursEscolar" per comparar directament.
    // Els registres antics que no el portin no es poden esborrar: si mai
    // n'apareixen, s'hi afegeix el camp i llavors sí.
    match /avaluacio/{registreId} {
      allow read: if esComptePersonal();
      allow create: if esComptePersonal();
      allow update: if false;
      allow delete: if esAdmin() && resource.data.cursEscolar == cursEnMarxa();
    }

    // Documentació: metadades de documents (els fitxers en si aniran a Cloudflare R2).
    match /documentacio/{registreId} {
      allow read: if esComptePersonal();
      allow create: if esComptePersonal();
      allow update, delete: if false;
    }

    // Fitxa central de l'alumne. Tothom del personal la pot consultar (cal
    // per passar llista, posar notes, etc.), però només l'administrador
    // la pot donar d'alta, editar o desactivar.
    match /alumnes/{alumneId} {
      allow read: if esComptePersonal();
      allow write: if esAdmin();
    }

    // Calendari escolar: tothom del personal el pot consultar (cal per
    // calcular l'absentisme), però només l'administrador el pot crear o editar.
    match /calendari/{cursId} {
      allow read: if esComptePersonal();
      allow write: if esAdmin();
    }

    // Configuració general de l'aplicació.
    // - "backup": només l'administrador (és qui té accés al mòdul).
    // - "contactes", "pesosTEE", "llindarsCL": tot el personal els pot
    //   llegir; només l'administrador els pot editar.
    match /configuracio/backup {
      allow read, write: if esAdmin();
    }
    match /configuracio/contactes {
      allow read: if esComptePersonal();
      allow write: if esAdmin();
    }
    match /configuracio/pesosTEE {
      allow read: if esComptePersonal();
      allow write: if esAdmin();
    }
    match /configuracio/llindarsCL {
      allow read: if esComptePersonal();
      allow write: if esAdmin();
    }
    match /configuracio/{altres} {
      allow read, write: if esAdmin();
    }

    // Versions amb nom de les còpies de seguretat (nomès administrador,
    // conté una instantània completa de la llista d'alumnes per poder-la
    // restaurar).
    match /versions/{versioId} {
      allow read, write: if esAdmin();
    }

    // Economia: aportacions econòmiques de les famílies. Només accessible
    // per l'administrador (ce@escolamestregibert.cat) — dades sensibles.
    match /economia/{cursEscolarId} {
      allow read, write: if esAdmin();
    }

    // PGAC: seguiment de la Programació General Anual de Centre. Només
    // accessible per l'administrador.
    match /pgac/{cursEscolarId} {
      allow read, write: if esAdmin();
    }

    // Valoracions de cicle/comissió/equip i festes: qualsevol docent pot
    // llegir-les i escriure-hi (les omplen ells mateixos); el mòdul
    // "Matriu General" (nomès admin) les llegeix totes juntes.
    match /valoracions/{valoracioId} {
      allow read, write: if esComptePersonal();
    }

    // Valoracions detallades de festes (objectius + desglossament per
    // cicle/equip amb activitats i grau d'assoliment) — mateix accés.
    match /festesDetall/{festaId} {
      allow read, write: if esComptePersonal();
    }

    // Valoració detallada de les activitats complementàries/sortides, per
    // cicle — mateix accés que la resta de valoracions.
    match /activitatsComplementariesDetall/{activitatId} {
      allow read, write: if esComptePersonal();
    }

    // Configuració de quines comissions/equips i festes estan actives cada
    // curs — nomès l'administrador la pot canviar, però tot el personal la
    // pot llegir (per saber quines opcions els han de sortir).
    match /valoracionsConfig/{cursEscolarId} {
      allow read: if esComptePersonal();
      allow write: if esAdmin();
    }

    // Per defecte, tot el que no s'hagi definit explícitament queda bloquejat.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
